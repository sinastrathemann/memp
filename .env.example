# mEXP — Environment Reference
# Wird beim Hub-Onboarding automatisch aus dem Image gelesen.

# Auth-Modus: "hub" (Produktion, X-MSQ-Header-Pflicht) | "dev-bypass" (lokal)
AUTH_MODE=hub

# Verzeichnis für persistente JSON-Files (im Container: benanntes Volume)
MEXP_DATA_DIR=/app/data

# HTTP-Server
PORT=3000
HOST=0.0.0.0

# Zeitzone für Log-Timestamps und Terminberechnung
TZ=Europe/Berlin

# Log-Level: debug | info | warn | error
LOG_LEVEL=info

# Node-Umgebung (production erzwingt AUTH_MODE=hub Default)
NODE_ENV=production

# --- Personio (optional; Employee-Sync) ---
# Aus Personio Admin: Einstellungen → Integrationen → API-Zugangsdaten
PERSONIO_CLIENT_ID=
PERSONIO_CLIENT_SECRET=
PERSONIO_API_URL=https://api.personio.de/v1

# --- SharePoint (Werkstudi/Praktikanten-Sync via Microsoft Graph) ---
# Aus Azure Portal → Entra ID → App-Registrierungen → mEXP-SharePoint-Sync
# Site-URL und Listen-ID sind Pflicht, sobald der Sync genutzt wird — es gibt
# bewusst keine Defaults mehr (SEC-23). Die echten Werte stehen im Passwort-
# manager bzw. in der Hub-Konfiguration, nicht im Repository.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_STUDIS_LIST_ID=

# --- DB-Seed (nur lokal, nur fuer `pnpm db:seed` mit gesetzter DATABASE_URL) ---
# Ohne diese Werte bricht das Seed-Skript ab, statt ein bekanntes Passwort zu
# vergeben (SEC-05). Bitte ein zufaelliges Passwort verwenden.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=
